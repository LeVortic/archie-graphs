{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/common.schema.json",
  "title": "ArchiE Graphs common types",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^archie\\.[a-z0-9-]+\\.v[0-9]+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "start_column", "end_line", "end_column"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 }
      }
    },
    "extractorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "interface_version", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "interface_version": { "type": "string", "const": "archie.extractor-interface.v1" },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "component", "recoverable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "severity": { "type": "string", "enum": ["info", "warning", "error", "fatal"] },
        "message": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" },
        "path": { "$ref": "#/$defs/relativePath" },
        "source": { "$ref": "#/$defs/sourceSpan" },
        "details": { "type": "object" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "target_frameworks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "qualified_name", "project_id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "enum": ["solution", "project", "namespace", "type", "method", "field", "property", "event"] },
        "name": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "project_id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/sourceSpan" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "enum": ["contains", "references", "inherits", "implements", "field_use", "constructor_use", "calls", "returns", "parameter_type"] },
        "status": { "type": "string", "enum": ["extracted", "unresolved", "inferred"] },
        "source": { "$ref": "#/$defs/sourceSpan" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "support_status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string", "minLength": 1 },
        "support_status": { "type": "string", "enum": ["supported", "unsupported", "uncertain"] },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      }
    }
  }
}
