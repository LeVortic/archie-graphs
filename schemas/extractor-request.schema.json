{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/extractor-request.schema.json",
  "title": "Extractor request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input", "options"],
  "properties": {
    "schema_version": { "const": "archie.extractor-request.v1" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["solution", "project", "repository"] }
      }
    },
    "requested_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_unresolved": { "type": "boolean", "default": true },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}
