{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/evidence-ref.schema.json",
  "title": "Evidence reference",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "const": "source_span" },
        "source": { "$ref": "common.schema.json#/$defs/sourceSpan" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "edge_id"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "const": "graph_edge" },
        "edge_id": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "node_ids", "edge_ids"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "const": "graph_path" },
        "node_ids": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "edge_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
      }
    }
  ]
}
