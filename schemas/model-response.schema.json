{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/model-response.schema.json",
  "title": "Local model claim response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abstain",
    "claims"
  ],
  "properties": {
    "abstain": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^evidence:[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
