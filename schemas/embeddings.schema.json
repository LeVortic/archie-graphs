{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/embeddings.schema.json",
  "title": "Local source embeddings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "device",
    "source_content_hash",
    "records",
    "cache",
    "extraction_status",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "archie.embeddings.v1"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "vector"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^chunk:[a-f0-9]{64}$"
          },
          "vector": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8192,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reused",
        "embedded"
      ],
      "properties": {
        "reused": {
          "type": "integer",
          "minimum": 0
        },
        "embedded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "runtime",
        "runtime_version",
        "dimensions",
        "max_tokens",
        "normalized"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32768
        },
        "normalized": {
          "const": true
        }
      }
    }
  }
}
