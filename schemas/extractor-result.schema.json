{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/extractor-result.schema.json",
  "title": "Extractor result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extractor", "input", "status", "projects", "nodes", "edges", "diagnostics"],
  "properties": {
    "schema_version": { "const": "archie.extractor-result.v1" },
    "schema_revision": { "type": "integer", "minimum": 1, "default": 1 },
    "extractor": { "$ref": "common.schema.json#/$defs/extractorInfo" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_revision": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["succeeded", "partial", "failed"] },
    "projects": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/project" } },
    "nodes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/edge" } },
    "diagnostics": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/diagnostic" } }
  }
}
