{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/graph-context.schema.json",
  "title": "Snapshot-backed graph answering context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_id",
    "extractor",
    "paths",
    "diagnostics"
  ],
  "properties": {
    "index_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "extractor": {
      "$ref": "common.schema.json#/$defs/extractorInfo"
    },
    "paths": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodes",
          "edges",
          "source_chunks"
        ],
        "properties": {
          "evidence_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "$ref": "common.schema.json#/$defs/node"
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "common.schema.json#/$defs/edge"
            }
          },
          "source_chunks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "source-chunk.schema.json"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_node_ids",
        "limits",
        "truncated",
        "truncation_reasons",
        "skipped_unbacked_edges"
      ],
      "properties": {
        "seed_node_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_seeds",
            "max_depth",
            "max_nodes_per_seed",
            "max_edges_per_seed",
            "max_paths",
            "max_paths_per_pair",
            "max_steps_per_pair"
          ],
          "properties": {
            "max_seeds": {
              "const": 5
            },
            "max_depth": {
              "const": 2
            },
            "max_nodes_per_seed": {
              "const": 100
            },
            "max_edges_per_seed": {
              "const": 30
            },
            "max_paths": {
              "const": 20
            },
            "max_paths_per_pair": {
              "const": 2
            },
            "max_steps_per_pair": {
              "const": 1000
            }
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "skipped_unbacked_edges": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
