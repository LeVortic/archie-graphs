{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/benchmark.schema.json",
  "title": "Versioned reviewed benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "split",
    "research_question",
    "source",
    "review",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "archie.benchmark.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "held_out"
      ]
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_hash",
        "revision",
        "provenance_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "benchmark-question.schema.json"
      }
    }
  }
}
