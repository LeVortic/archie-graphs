{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/experiment-record.schema.json",
  "title": "Experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "benchmark_version",
    "seed",
    "configuration",
    "answers"
  ],
  "properties": {
    "schema_version": {
      "const": "archie.experiment-record.v1"
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "context_budget_tokens",
        "modes"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "embedding_model_id": {
          "type": "string"
        },
        "context_budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "source",
              "graph"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "software_hash": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "embedding_identity": {
          "$ref": "embeddings.schema.json#/$defs/model"
        },
        "graph_limits": {
          "$ref": "graph-context.schema.json#/properties/diagnostics/properties/limits"
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "answer-record.schema.json"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "complete"
      ]
    },
    "benchmark_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "index_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "benchmark_snapshot": {
      "$ref": "benchmark.schema.json"
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "mode"
        ],
        "properties": {
          "question_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "mode": {
            "enum": [
              "source",
              "graph"
            ]
          }
        }
      }
    },
    "in_flight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "mode",
        "started_at"
      ],
      "properties": {
        "question_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "mode": {
          "enum": [
            "source",
            "graph"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
