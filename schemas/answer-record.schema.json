{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeVortic/archie-graphs/schemas/answer-record.schema.json",
  "title": "Answer record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "mode", "answer", "claims", "evidence", "run", "status"],
  "properties": {
    "schema_version": { "const": "archie.answer-record.v1" },
    "schema_revision": { "type": "integer", "minimum": 1, "default": 1 },
    "question": {"type": "string", "minLength": 1},
    "index_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "context_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "raw_response": {"type": "string"},
    "extraction_status": {"type": "string", "enum": ["succeeded", "partial"]},
    "source_diagnostics": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/diagnostic"}},
    "graph_context": {"$ref": "graph-context.schema.json"},
    "question_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "mode": { "type": "string", "enum": ["source", "graph"] },
    "answer": { "type": "string" },
    "claims": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/claim" } },
    "evidence": { "type": "array", "items": { "$ref": "evidence-ref.schema.json" } },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "context_tokens", "latency_ms"],
      "properties": {
        "model_id": { "type": "string" },
        "model_revision": {"type": "string"},
        "runtime_version": {"type": "string"},
        "device": {"type": "string"},
        "dtype": {"type": "string"},
        "context_budget": {"type": "integer", "minimum": 0},
        "max_new_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "finish_reason": {"type": "string", "enum": ["stop", "length"]},
        "embedding_model_id": { "type": "string" },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "status": { "type": "string", "enum": ["succeeded", "failed"] },
    "error": { "$ref": "common.schema.json#/$defs/diagnostic" }
  }
}
